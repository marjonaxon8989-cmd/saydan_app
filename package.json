{
  "name": "saydan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SAYDAN \u2014 kosmetika tarkibi (ingredient) ma'lumot platformasi",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.mjs",
    "migrate": "node --disable-warning=ExperimentalWarning tools/migrate.mjs",
    "import": "node --disable-warning=ExperimentalWarning tools/import-xlsx.mjs",
    "seed:demo": "node --disable-warning=ExperimentalWarning tools/seed-demo.mjs",
    "admin:status": "node --disable-warning=ExperimentalWarning tools/admin-status.mjs",
    "admin:rebind": "node --disable-warning=ExperimentalWarning tools/admin-rebind.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/*.test.mjs",
    "setup": "node --disable-warning=ExperimentalWarning tools/migrate.mjs && node --disable-warning=ExperimentalWarning tools/import-xlsx.mjs seed/ingrident.xlsx"
  }
}